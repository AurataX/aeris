# Copy to .env (gitignored) for local dev. Production values live in each platform's secret store.
# Never paste real values into chat, code or git.

# --- Databricks (Azure) -------------------------------------------------
DATABRICKS_HOST=https://adb-7405619537081466.6.azuredatabricks.net
# Service principal (OAuth M2M) used by FastAPI + collector; prefer over PATs
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_JOB_ID=
DATABRICKS_WAREHOUSE_ID=

# --- Data sources (also stored in Databricks secret scope `aeris`) -------
OPENAQ_API_KEY=
DATA_GOV_IN_API_KEY=

# --- AWS ----------------------------------------------------------------
AWS_REGION=ap-south-1
AERIS_S3_BUCKET=

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://ttdduchixyhuzpnkodyj.supabase.co
# Read-only role for FastAPI (session pooler, IPv4)
SUPABASE_DB_URL_API=postgresql://aeris_api.ttdduchixyhuzpnkodyj:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Write role for the Databricks sync task — store ONLY in Databricks secret scope `aeris`
# SUPABASE_DB_URL_SYNC=

# --- FastAPI (apps/api) -------------------------------------------------
API_ADMIN_KEY=
API_CORS_ORIGINS=http://localhost:3000
RUN_NOW_COOLDOWN_SECONDS=600

# --- Web (apps/web) -----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://ttdduchixyhuzpnkodyj.supabase.co
# publishable key is public by design (RLS limits it to SELECT on sync_runs)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_8M6Fejsm-VlUnb3sdQPvvQ_t4s1axm_
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_DATABRICKS_DASHBOARD_EMBED_URL=
NEXT_PUBLIC_POWERBI_EMBED_URL=
REVALIDATE_SECRET=

# --- Collector (apps/collector) — set with `npx wrangler secret put <NAME>`, not here
# OPENAQ_API_KEY, DATA_GOV_IN_API_KEY, DATABRICKS_HOST, DATABRICKS_CLIENT_ID, DATABRICKS_CLIENT_SECRET
