				db = Source{[Name = "aeris_brick", Kind = "Database"]}[Data],
				schema = db{[Name = "gold", Kind = "Schema"]}[Data],
				tbl = schema{[Name = "weather_pollution_daily", Kind = "Table"]}[Data]
			in
