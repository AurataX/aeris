	measure 'Pearson r (PM2.5, wind)' = VAR t = FILTER(weather_pollution_daily, NOT ISBLANK(weather_pollution_daily[pm25_avg]) && NOT ISBLANK(weather_pollution_daily[wind_avg_kmh])) VAR mx = AVERAGEX(t, weather_pollution_daily[wind_avg_kmh]) VAR my = AVERAGEX(t, weather_pollution_daily[pm25_avg]) RETURN DIVIDE(SUMX(t, (weather_pollution_daily[wind_avg_kmh]-mx)*(weather_pollution_daily[pm25_avg]-my)), SQRT(SUMX(t, (weather_pollution_daily[wind_avg_kmh]-mx)^2) * SUMX(t, (weather_pollution_daily[pm25_avg]-my)^2)))
		formatString: 0.00
		displayFolder: Weather
		lineageTag: 70245b3f-48be-47a8-a62e-62926f042c35

	partition weather_pollution_daily = m
		mode: import
		source =
