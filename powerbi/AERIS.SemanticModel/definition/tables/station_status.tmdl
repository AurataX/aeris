	measure 'Stations in model' = DISTINCTCOUNT(station_status[station_id])
		formatString: 0
		displayFolder: Stations
		lineageTag: 2750a418-de90-47de-84fb-b4725a5c8c83

	measure 'Stations reporting' = CALCULATE(COUNTROWS(station_status), station_status[is_stale] = FALSE())
		formatString: 0
		displayFolder: Stations
		lineageTag: 61bb3903-7a1f-41b9-85a4-891eccd9816f

	measure 'Data freshness (hours)' = DATEDIFF(MAX(station_status[last_observed_at]), UTCNOW(), HOUR)
		formatString: 0
		displayFolder: Stations
		lineageTag: 077af050-47e7-49dc-80fc-de427713cf9f

	partition station_status = m
