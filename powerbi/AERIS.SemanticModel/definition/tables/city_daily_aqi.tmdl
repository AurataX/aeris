	measure 'NAQI (avg)' = AVERAGE(city_daily_aqi[naqi])
		formatString: 0
		displayFolder: AQI
		lineageTag: 8828be14-ffb0-41a9-8f77-52d22d25a957

	measure 'NAQI (peak)' = MAX(city_daily_aqi[naqi])
		formatString: 0
		displayFolder: AQI
		lineageTag: dfe3dd91-a25e-4515-9e38-fa835c08a2a0

	measure 'Very Poor+ days' = CALCULATE(COUNTROWS(city_daily_aqi), city_daily_aqi[naqi] > 300)
		formatString: 0
		displayFolder: AQI
		lineageTag: c9f7d5c2-bf9e-470d-94cc-8cec5ad18847

	measure 'Days with data' = CALCULATE(COUNTROWS(city_daily_aqi), NOT ISBLANK(city_daily_aqi[naqi]))
		formatString: 0
		displayFolder: AQI
		lineageTag: 0dbdc1a0-d874-4556-af83-1b0afe06dee1

	measure '% days Very Poor+' = DIVIDE([Very Poor+ days], [Days with data])
		formatString: 0.0%
		displayFolder: AQI
		lineageTag: decc13c8-9167-477f-bf8d-af8874b545fb

	measure 'NAQI 7-day rolling' = AVERAGEX(DATESINPERIOD(dim_date[Date], MAX(dim_date[Date]), -7, DAY), [NAQI (avg)])
		formatString: 0
		displayFolder: AQI
		lineageTag: c5a56d83-8083-402b-b0e3-c88c10e8f327

	measure 'NAQI vs last month' = [NAQI (avg)] - CALCULATE([NAQI (avg)], DATEADD(dim_date[Date], -1, MONTH))
		formatString: +0;-0;0
		displayFolder: AQI
		lineageTag: 6660df77-bb34-4a16-81dc-687761322d1c

	measure 'PM2.5 avg' = AVERAGE(city_daily_aqi[pm25_avg])
		formatString: 0.0
		displayFolder: Pollutants
		lineageTag: ac05362a-074d-4a94-8568-c96543af5b24

	measure 'PM10 avg' = AVERAGE(city_daily_aqi[pm10_avg])
		formatString: 0.0
		displayFolder: Pollutants
		lineageTag: 03d44bd8-806b-4535-bffa-217f326269fd

	partition city_daily_aqi = m
