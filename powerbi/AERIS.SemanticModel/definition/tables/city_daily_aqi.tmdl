	measure 'NAQI (avg)' = AVERAGE(city_daily_aqi[naqi])
		formatString: 0
		displayFolder: AQI
		lineageTag: 1b5482b4-2c95-436e-9f29-94c955a6ef15

	measure 'NAQI (peak)' = MAX(city_daily_aqi[naqi])
		formatString: 0
		displayFolder: AQI
		lineageTag: c29aca0e-b42a-424b-8709-16bf6fb0129a

	measure 'Very Poor+ days' = CALCULATE(COUNTROWS(city_daily_aqi), city_daily_aqi[naqi] > 300)
		formatString: 0
		displayFolder: AQI
		lineageTag: aa5b28cb-fafe-4619-94aa-b674bcae5b71

	measure 'Days with data' = CALCULATE(COUNTROWS(city_daily_aqi), NOT ISBLANK(city_daily_aqi[naqi]))
		formatString: 0
		displayFolder: AQI
		lineageTag: a6dc9fad-a94c-44a4-897e-d180547d9079

	measure '% days Very Poor+' = DIVIDE([Very Poor+ days], [Days with data])
		formatString: 0.0%
		displayFolder: AQI
		lineageTag: fbc0fde4-87b0-4667-b0ea-bb8bf655c6ff

	measure 'NAQI 7-day rolling' = AVERAGEX(DATESINPERIOD(dim_date[Date], MAX(dim_date[Date]), -7, DAY), [NAQI (avg)])
		formatString: 0
		displayFolder: AQI
		lineageTag: d57552de-083b-4009-ad71-99a2a594a9f9

	measure 'NAQI vs last month' = [NAQI (avg)] - CALCULATE([NAQI (avg)], DATEADD(dim_date[Date], -1, MONTH))
		formatString: +0;-0;0
		displayFolder: AQI
		lineageTag: 6016bb23-f489-489d-a012-3ecd5d730c33

	measure 'PM2.5 avg' = AVERAGE(city_daily_aqi[pm25_avg])
		formatString: 0.0
		displayFolder: Pollutants
		lineageTag: d26adf8c-dba3-46ac-a70c-d8e81e945dce

	measure 'PM10 avg' = AVERAGE(city_daily_aqi[pm10_avg])
		formatString: 0.0
		displayFolder: Pollutants
		lineageTag: ed84f199-2ecd-4a1a-9060-efbc8c38b184

	partition city_daily_aqi = m
		mode: import
		source =
