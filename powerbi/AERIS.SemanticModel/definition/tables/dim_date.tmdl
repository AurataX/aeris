table dim_date
	lineageTag: 863b1e21-f399-4d37-a855-56605bcc0b0d
	dataCategory: Time

	column Date
		dataType: dateTime
		lineageTag: 35742467-f3c9-41da-a523-3d4a513bd08f
		summarizeBy: none
		sourceColumn: [Date]
		isKey
		formatString: dd mmm yyyy

	column Year
		dataType: int64
		lineageTag: 82233987-e8b9-4c4b-801f-6fbcafb75520
		summarizeBy: none
		sourceColumn: [Year]

	column MonthNumber
		dataType: int64
		lineageTag: 30ae798e-d9a4-4fb7-a58f-e995b58265a0
		summarizeBy: none
		sourceColumn: [MonthNumber]

	column Month
		dataType: string
		lineageTag: df018b48-103c-49e2-80b5-518891733a85
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: MonthNumber

	column Season
		dataType: string
		lineageTag: cac7aab8-ada9-41fa-97ac-2b1f4d6c9f0c
		summarizeBy: none
		sourceColumn: [Season]

	partition dim_date = calculated
		mode: import
		source =
			ADDCOLUMNS(CALENDAR(DATE(2025, 1, 1), DATE(2026, 12, 31)), "Year", YEAR([Date]), "MonthNumber", MONTH([Date]), "Month", FORMAT([Date], "MMM"), "Season", SWITCH(TRUE(), MONTH([Date]) IN {12, 1, 2}, "Winter", MONTH([Date]) IN {3, 4, 5}, "Summer", MONTH([Date]) IN {6, 7, 8, 9}, "Monsoon", "Post-monsoon"))
