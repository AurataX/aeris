table dim_date
	lineageTag: 667ce944-c4ed-40f0-a16e-2b9d43f90d3f
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: 780c675b-32c6-4313-b6b1-934b304cea27
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		lineageTag: d8d28e7f-16e2-43d0-880b-23203db580cf
		summarizeBy: none
		sourceColumn: [Year]

	column MonthNumber
		dataType: int64
		lineageTag: 820b445e-7f23-400a-92ec-2d8279022476
		summarizeBy: none
		sourceColumn: [MonthNumber]

	column Month
		dataType: string
		lineageTag: b3c1aee4-d518-467b-9599-6bb62fc82881
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: MonthNumber

	column Season
		dataType: string
		lineageTag: 886fcf64-8e50-4ad9-9e83-47fae53aa1c8
		summarizeBy: none
		sourceColumn: [Season]

	partition dim_date = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2025, 1, 1), DATE(2026, 12, 31)), "Year", YEAR([Date]), "MonthNumber", MONTH([Date]), "Month", FORMAT([Date], "MMM"), "Season", SWITCH(TRUE(), MONTH([Date]) IN {12, 1, 2}, "Winter", MONTH([Date]) IN {3, 4, 5}, "Summer", MONTH([Date]) IN {6, 7, 8, 9}, "Monsoon", "Post-monsoon"))

