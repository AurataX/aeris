	measure 'Days over NAAQS limit' = CALCULATE(COUNTROWS(pollutant_trends), pollutant_trends[exceeds_naaqs] = TRUE())
		formatString: 0
		displayFolder: Pollutants
		lineageTag: 3c6dc375-6ca8-4bb7-9ed2-0c1524ffc7dd

	measure '% days over NAAQS' = DIVIDE([Days over NAAQS limit], COUNTROWS(pollutant_trends))
		formatString: 0.0%
		displayFolder: Pollutants
		lineageTag: ab69c407-a7a7-4b02-84a8-f3654f4d9826

	partition pollutant_trends = m
		mode: import
		source =
