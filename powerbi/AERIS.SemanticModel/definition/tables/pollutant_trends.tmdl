	measure 'Days over NAAQS limit' = CALCULATE(COUNTROWS(pollutant_trends), pollutant_trends[exceeds_naaqs] = TRUE())
		formatString: 0
		displayFolder: Pollutants
		lineageTag: f78cf57d-fa8d-4a45-ac58-d1bb47a5d310

	measure '% days over NAAQS' = DIVIDE([Days over NAAQS limit], COUNTROWS(pollutant_trends))
		formatString: 0.0%
		displayFolder: Pollutants
		lineageTag: 2e6f7021-3808-4b1d-bd74-523b91c62889

	partition pollutant_trends = m
		mode: import
		source =
			let
				Source = Databricks.Catalogs("adb-7405619537081466.6.azuredatabricks.net", "/sql/1.0/warehouses/5da0413f120f41ed", [Catalog = "aeris_brick", Database = null, EnableAutomaticProxyDiscovery = null]),
