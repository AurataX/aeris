model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_city","dim_pollutant","city_daily_aqi","pollutant_trends","weather_pollution_daily","station_status"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_city
ref table dim_pollutant
ref table city_daily_aqi
ref table pollutant_trends
ref table weather_pollution_daily
ref table station_status
ref table dim_date

