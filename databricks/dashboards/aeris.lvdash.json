{
  "datasets": [
    {
      "name": "ds_daily",
      "displayName": "City daily NAQI",
      "queryLines": [
        "SELECT city, date_ist, naqi, naqi_category, dominant_pollutant,\n",
        "       pm25_avg, pm10_avg, no2_avg, o3_max8h, stations_count,\n",
        "       CASE WHEN naqi > 300 THEN 1 ELSE 0 END AS very_poor_day\n",
        "FROM city_daily_aqi WHERE naqi IS NOT NULL\n"
      ]
    },
    {
      "name": "ds_trends",
      "displayName": "Pollutant trends",
      "queryLines": [
        "SELECT t.city, t.date_ist, p.display_name AS pollutant, t.avg_value, t.max_value, p.naaqs_limit,\n",
        "       CASE WHEN t.exceeds_naaqs THEN 1 ELSE 0 END AS over_limit\n",
        "FROM pollutant_trends t JOIN dim_pollutant p ON t.pollutant = p.pollutant\n",
        "WHERE t.pollutant <> 'co'\n"
      ]
    },
    {
      "name": "ds_weather",
      "displayName": "Weather vs pollution",
      "queryLines": [
        "SELECT city, date_ist, pm25_avg, temp_avg_c, humidity_avg_pct, wind_avg_kmh, precip_sum_mm\n",
        "FROM weather_pollution_daily WHERE pm25_avg IS NOT NULL\n"
      ]
    },
    {
      "name": "ds_stations",
      "displayName": "Monitoring stations",
      "queryLines": [
        "SELECT name, city, lat, lon, naqi_24h, naqi_category, round(pm25_latest, 1) AS pm25_latest,\n",
        "       last_observed_at, CASE WHEN is_stale THEN 'stale' ELSE 'reporting' END AS status\n",
        "FROM station_status\n"
      ]
    },
    {
      "name": "ds_ops",
      "displayName": "Pipeline row counts",
      "queryLines": [
        "SELECT layer, table_name, row_count, computed_at\n",
        "FROM aeris_brick.ops.table_stats\n",
        "WHERE run_id = (SELECT max_by(run_id, computed_at) FROM aeris_brick.ops.table_stats)\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
