      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# AERIS · Delhi NCR Air Quality\n",
                "\n",
                "Indian NAQI computed with the **CPCB method** from 62 OpenAQ ground monitors (Jan 2025 → Nov 2026). Air is cleanest in the monsoon (Aug ≈ 95) and worst in Nov–Dec (≈ 350), every year. Daily values need ≥ 16 hours of data. Source: OpenAQ archive on AWS S3 + live collector · processed with Spark on Azure Databricks (Bronze → Silver → Gold)."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi-avg-naqi",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "disaggregated": false,
                  "fields": [
                    {
                      "name": "avg(naqi)",
                      "expression": "AVG(`naqi`)"
                    },
                    {
                      "name": "weekly(date_ist)",
                      "expression": "DATE_TRUNC(\"WEEK\", `date_ist`)"
